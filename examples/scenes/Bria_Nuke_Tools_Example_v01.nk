  inputs 0
  name input_image
  label Original
  xpos 33
 }
set Nbb437700 [stack 0]
 Copy {
  inputs 2
  from0 rgba.red
  to0 rgba.alpha
  name copy_mask_to_alpha
  label "mask.r → alpha"
 }
 Premult {
  name premult_mask
 }
push $Nbb435e00
