 Input {
  inputs 0
  name input_mask
  label Mask
  xpos 143
  number 1
 }
 Input {
  inputs 0
  name input_structured_prompt
  label "Structured Prompt"
  xpos 253
  number 2
 }
 Read {
  inputs 0
  file_type png
  file /Users/danielnaulin/Desktop/Nuke_Tool_Testing/images/fibo_edit/bria_fibo_edit_result_1779841402889.png
  name loader_result
  label After
  xpos 363
  ypos -24
 }
set Nbb1fcf00 [stack 0]
 Blur {
  size {{parent.mask_edge_softness}}
  name mask_blur
  label "AA staircase"
 }
 FilterErode {
  size {{"parent.mask_edge_softness * 0.5"}}
  name mask_erode
  label "compensate blur expansion"
 }
 Input {
  inputs 0
  name input_image
  label Original
  xpos 33
 }
set Nbb1fe800 [stack 0]
 Copy {
  inputs 2
  from0 rgba.red
  to0 rgba.alpha
  name copy_mask_to_alpha
  label "mask.r → alpha"
 }
 Premult {
  name premult_mask
 }
push $Nbb1fcf00
 Read {
  inputs 0
  file_type png
  file /Users/danielnaulin/Desktop/Nuke_Tool_Testing/images/fibo_edit/bria_fibo_edit_result_1779841300262.png
  name loader_before
  label "Before (previous edit)"
  xpos 253
  ypos -24
 }
push $Nbb1fe800
 Switch {
  inputs 2
  name switch_compare_source
  label "0=Original / 1=Previous Edit"
  xpos 253
  ypos 72
 }
 Switch {
  inputs 2
  which 1
  name switch_before_after
  label "0=Before selection / 1=After"
  xpos 363
  ypos 72
 }
 Switch {
  inputs 2
  which {{parent.premultiply_with_mask}}
  name switch_premult
  label "0=raw / 1=premultiplied"
 }
 Output {
  name output1
  xpos 363
  ypos 96
 }
end_group
