 addUserKnob {26 prompt_sep l "" +STARTLINE}
 addUserKnob {43 prompt l Prompt t "Describe the scene to generate structured prompt JSON."}
 prompt "Analyze the incoming image colors, create a palette of complimentary colors for our new image. The complimentary colors should be chosen such that they will stand out and be visible over the incoming image, while maintaining the overall color style of the incoming image. Our new image is only the word \"IMAGINE\" as large bold text centered on a solid black background, spanning the full width of the frame. No logos, no icons, no graphics, no symbols, only typography. This is a minimal and classy full frame brand text treatment\n\n\n"
 addUserKnob {22 load_structured_prompt_input l "Load JSON/VGL" t "Load a JSON/VGL file into Structured Prompt Input." +DISABLED T "import structured_prompt as _bria_sp; _bria_sp.on_load_structured_prompt_input()" +STARTLINE}
 addUserKnob {43 structured_prompt_input l "Structured Prompt Input" t "Optional existing structured prompt JSON for refine mode (requires Prompt)." +DISABLED +HIDDEN}
 structured_prompt_input "\n\n\n"
 addUserKnob {6 lock_vgl l "Lock VGL" -STARTLINE}
 addUserKnob {22 run_structured_prompt l "Generate VGL" T "import structured_prompt as _bria_sp; _bria_sp.on_structured_prompt()" +STARTLINE}
 addUserKnob {6 use_custom_label l "Custom File Name" t "Enable to set a custom name for the saved JSON filename." -STARTLINE}
 addUserKnob {1 output_label l Name t "Name used in the output filename: bria_structured_prompt_\{name\}_\{id\}.json" +DISABLED +HIDDEN}
 addUserKnob {26 result_sep l "" +STARTLINE}
 addUserKnob {6 use_global_project_path l "Use Global Project Path" +STARTLINE}
 addUserKnob {2 result_path l "Result Path" t "Optional directory or .json file path for saved structured prompt output. Default folder is prompt."}
 result_path /var/folders/q6/fsklnzwx20jg_ydn82gmshyw0000gn/T/bria/prompt/bria_structured_prompt_result_1779994453291.json
 addUserKnob {43 structured_prompt_output l "Structured Prompt" t "Generated structured prompt JSON output."}
 structured_prompt_output "\{\n  \"short_description\": \"A minimalist and classy full-frame brand text treatment featuring the word \\\"IMAGINE\\\" in large, bold, sans-serif typography, centered on a solid black background. The text is rendered in a vibrant, complementary color that stands out against the dark background while maintaining an elegant aesthetic.\",\n  \"background_setting\": \"A solid, deep black void that fills the entire frame, creating a stark and sophisticated backdrop for the typography.\",\n  \"lighting\": \{\n    \"conditions\": \"Even, soft ambient lighting, designed to illuminate the text without harsh reflections.\",\n    \"direction\": \"Front-lit from a diffused, unseen source.\",\n    \"shadows\": \"Minimal shadows, contributing to the flat, graphic presentation of the text.\"\n  \},\n  \"aesthetics\": \{\n    \"composition\": \"Centered, with the text spanning the full width of the frame, creating a strong horizontal emphasis. The composition is extremely clean and balanced.\",\n    \"color_scheme\": \"High contrast, primarily black with a single, vibrant complementary color for the text, possibly a rich magenta or electric blue, chosen for visual impact and elegance.\",\n    \"mood_atmosphere\": \"Modern, sophisticated, inspiring, and minimalist.\",\n    \"aesthetic_score\": \"very high\",\n    \"preference_score\": \"very high\"\n  \},\n  \"photographic_characteristics\": \{\n    \"depth_of_field\": \"Deep, ensuring all elements, though minimal, are in sharp focus.\",\n    \"focus\": \"Sharp focus on the text, which is the sole subject.\",\n    \"camera_angle\": \"Eye-level, directly facing the flat plane of the text.\",\n    \"lens_focal_length\": \"Standard lens (e.g., 50mm) to avoid distortion and maintain a natural perspective.\"\n  \},\n  \"style_medium\": \"digital illustration\",\n  \"text_render\": \[\n    \{\n      \"text\": \"IMAGINE\",\n      \"location\": \"center\",\n      \"size\": \"large within frame\",\n      \"color\": \"magenta\",\n      \"font\": \"bold sans-serif typeface\",\n      \"appearance_details\": \"Clean, crisp edges, with a slight luminosity that suggests a subtle inner glow.\"\n    \}\n  ],\n  \"context\": \"This is a concept for a brand identity graphic or a title card for a presentation, emphasizing a forward-thinking and creative message through minimalist design.\",\n  \"artistic_style\": \"minimalist, graphic, bold\"\n\}\n\n\n\n\n"
