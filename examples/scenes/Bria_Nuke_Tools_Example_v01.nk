  name loader_result
  label After
  xpos 363
  ypos -24
 }
set Nbad0b200 [stack 0]
 Blur {
  size {{parent.mask_edge_softness}}
  name mask_blur
  label "AA staircase"
 }
 FilterErode {
  size {{"parent.mask_edge_softness * 0.5"}}
  name mask_erode
  label "compensate blur expansion"
 }
 Input {
  inputs 0
  name input_image
  label Original
  xpos 33
 }
set Nbad20f00 [stack 0]
 Copy {
  inputs 2
  from0 rgba.red
  to0 rgba.alpha
  name copy_mask_to_alpha
  label "mask.r → alpha"
 }
 Premult {
  name premult_mask
 }
push $Nbad0b200
 Read {
  inputs 0
  file_type png
  file /var/folders/q6/fsklnzwx20jg_ydn82gmshyw0000gn/T/bria/images/fibo_edit/bria_fibo_edit_result_1779137605710.png
  in_colorspace scene_linear
  out_colorspace scene_linear
  name loader_before
  label "Before (previous edit)"
  xpos 253
  ypos -24
 }
push $Nbad20f00
 Switch {
  inputs 2
  name switch_compare_source
  label "0=Original / 1=Previous Edit"
  xpos 253
  ypos 72
 }
 Switch {
  inputs 2
  which 1
  name switch_before_after
  label "0=Before selection / 1=After"
  xpos 363
  ypos 72
 }
 Switch {
  inputs 2
  which {{parent.premultiply_with_mask}}
  name switch_premult
  label "0=raw / 1=premultiplied"
 }
 Output {
  name output1
  xpos 363
  ypos 96
 }
end_group
