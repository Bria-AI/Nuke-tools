n    \"steps_num\": null,\n    \"compare_source\": \"Original\"\n  \},\n  \"timestamp_utc\": \"2026-05-05T07:59:34.761827+00:00\",\n  \"request_id\": \"c90948b3aa514371af5279fdbd45d034\"\n\}"
