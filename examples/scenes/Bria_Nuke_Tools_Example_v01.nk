 mask_edge_softness 1.5
 addUserKnob {1 _auto_prompt +HIDDEN}
 _auto_prompt "Isolate the following objects from the scene by removing everything else: the actor(s) in front of the greenscreen, the props(s) in front of the greenscreen, the set piece(s) in front of the greenscreen.\nSTRICT LOCKS (non-negotiable):\nDo NOT move, warp, scale, rotate, or reshape the actor(s) in front of the greenscreen, the props(s) in front of the greenscreen, and the set piece(s) in front of the greenscreen.\nDo NOT alter the actor(s) in front of the greenscreen's, the props(s) in front of the greenscreen's, and the set piece(s) in front of the greenscreen's color, texture, material, lighting, or shadows.\nPreserve the actor(s) in front of the greenscreen's, the props(s) in front of the greenscreen's, and the set piece(s) in front of the greenscreen's silhouette, edges, and fine detail exactly.\nScope of work:\nRemove EVERYTHING except the actor(s) in front of the greenscreen, the props(s) in front of the greenscreen, and the set piece(s) in front of the greenscreen from the scene.\nReplace the entire background and all other objects with a clean, flat, neutral medium gray backdrop (approximately RGB 128,128,128 / #808080).\nKeep any natural contact shadows or cast shadows directly attached to the actor(s) in front of the greenscreen, the props(s) in front of the greenscreen, and the set piece(s) in front of the greenscreen to preserve grounding, rendered softly on the gray backdrop.\nCRITICAL RULES:\nthe actor(s) in front of the greenscreen, the props(s) in front of the greenscreen, and the set piece(s) in front of the greenscreen must appear pixel-identical to the original — same position, same scale, same colors, same lighting.\nThe gray backdrop must be completely flat and uniform — no gradients, no texture, no vignetting, no visible seams.\nDo NOT add any new objects, props, or environmental elements.\nDo NOT include any remnants of the original background, other objects, or scene elements.\nClean, sharp edges around the actor(s) in front of the greenscreen, the props(s) in front of the greenscreen, and the set piece(s) in front of the greenscreen — no halos, no fringing, no bleeding from the removed background.\nResult requirement:\nThe output should appear as if the actor(s) in front of the greenscreen, the props(s) in front of the greenscreen, and the set piece(s) in front of the greenscreen were photographed against a seamless neutral gray studio backdrop. This flat gray background is optimized for downstream background removal (RMBG) — it should be easily separable from the subject. If the actor(s) in front of the greenscreen, the props(s) in front of the greenscreen, and the set piece(s) in front of the greenscreen cannot be identified, return the image unchanged."
 addUserKnob {6 preserve_alpha l "Preserve Alpha" +DISABLED +HIDDEN +STARTLINE}
 addUserKnob {3 seed l Seed t "Optional. Positive integer."}
 addUserKnob {3 guidance_scale l "Guidance Scale" t "Optional. Integer in range 1-5." R 1 5}
 guidance_scale 4
 addUserKnob {3 steps_num l Steps t "Optional. 0 means unset. Positive integer when set."}
 addUserKnob {43 prompt l Prompt t "Auto-filled from the selected category and preset. You can edit freely."}
 prompt "Isolate the following objects from the scene by removing everything else: the actor(s) in front of the greenscreen, the props(s) in front of the greenscreen, the set piece(s) in front of the greenscreen.\nSTRICT LOCKS (non-negotiable):\nDo NOT move, warp, scale, rotate, or reshape the actor(s) in front of the greenscreen, the props(s) in front of the greenscreen, and the set piece(s) in front of the greenscreen.\nDo NOT alter the actor(s) in front of the greenscreen's, the props(s) in front of the greenscreen's, and the set piece(s) in front of the greenscreen's color, texture, material, lighting, or shadows.\nPreserve the actor(s) in front of the greenscreen's, the props(s) in front of the greenscreen's, and the set piece(s) in front of the greenscreen's silhouette, edges, and fine detail exactly.\nScope of work:\nRemove EVERYTHING except the actor(s) in front of the greenscreen, the props(s) in front of the greenscreen, and the set piece(s) in front of the greenscreen from the scene.\nReplace the entire background and all other objects with a clean, flat, neutral medium gray backdrop (approximately RGB 128,128,128 / #808080).\nKeep any natural contact shadows or cast shadows directly attached to the actor(s) in front of the greenscreen, the props(s) in front of the greenscreen, and the set piece(s) in front of the greenscreen to preserve grounding, rendered softly on the gray backdrop.\nCRITICAL RULES:\nthe actor(s) in front of the greenscreen, the props(s) in front of the greenscreen, and the set piece(s) in front of the greenscreen must appear pixel-identical to the original — same position, same scale, same colors, same lighting.\nThe gray backdrop must be completely flat and uniform — no gradients, no texture, no vignetting, no visible seams.\nDo NOT add any new objects, props, or environmental elements.\nDo NOT include any remnants of the original background, other objects, or scene elements.\nClean, sharp edges around the actor(s) in front of the greenscreen, the props(s) in front of the greenscreen, and the set piece(s) in front of the greenscreen — no halos, no fringing, no bleeding from the removed background.\nResult requirement:\nThe output should appear as if the actor(s) in front of the greenscreen, the props(s) in front of the greenscreen, and the set piece(s) in front of the greenscreen were photographed against a seamless neutral gray studio backdrop. This flat gray background is optimized for downstream background removal (RMBG) — it should be easily separable from the subject. If the actor(s) in front of the greenscreen, the props(s) in front of the greenscreen, and the set piece(s) in front of the greenscreen cannot be identified, return the image unchanged.\n\n"
 addUserKnob {6 use_negative_prompt l "Negative Prompt" +STARTLINE}
 addUserKnob {43 negative_prompt l "Prompt (N)" t "Enter your negative prompt here!" +HIDDEN}
 negative_prompt "\n\n"
 addUserKnob {6 use_structured_prompt l "Structured Prompt (JSON)" +STARTLINE}
