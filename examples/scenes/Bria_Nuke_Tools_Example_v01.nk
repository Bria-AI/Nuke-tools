 addUserKnob {22 history_reveal_selected_result l "Preview File" T "import common as _bria_common; _bria_common.on_reveal_history_result()" +STARTLINE}
 addUserKnob {22 history_view_selected_metadata l "View Selected Metadata" T "import common as _bria_common; _bria_common.on_view_history_metadata()" +STARTLINE}
