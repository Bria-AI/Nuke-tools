 xpos 2964
 ypos -2916
 postage_stamp true
 addUserKnob {20 settings_tab l Settings}
 addUserKnob {26 bria_header l "" +STARTLINE T "Bria FIBO Generate"}
 addUserKnob {6 preserve_alpha l "Preserve Alpha" +STARTLINE}
 addUserKnob {4 aspect_ratio l "Aspect Ratio" M {1:1 2:3 3:2 3:4 4:3 4:5 5:4 9:16 16:9}}
 aspect_ratio 16:9
 addUserKnob {4 resolution l Resolution M {1MP 4MP}}
 addUserKnob {4 model l Model M {standard lite tailored}}
 addUserKnob {3 seed l Seed t "Optional. Positive integer."}
 addUserKnob {3 guidance_scale l "Guidance Scale" t "Optional. Integer in range 1-5." R 1 5}
 guidance_scale 4
 addUserKnob {3 steps_num l Steps t "Optional. 0 means unset. Positive integer when set."}
 addUserKnob {6 use_multiple_images l "Generate Multiple Images" t "Generate 2-4 variants per click. After Run, drag Image Index to preview them; click 'Use This Image' to lock in the one you want." -STARTLINE}
 addUserKnob {4 num_images l "Num Images" t "Number of variants to generate per call (2-4). All variants are saved to disk." +HIDDEN M {2 3 4}}
 num_images 4
 addUserKnob {7 result_variant l "Image Index" t "Drag to preview each variant from the most recent multi-image run. Click 'Use This Image' to lock in the selected variant." +HIDDEN R 1 1}
 result_variant 1
 addUserKnob {22 use_this_image l "Use This Image" t "Promote the currently-displayed variant to the canonical Result Path." -STARTLINE +HIDDEN T "import importlib, fibo_generate as _bria_fg; importlib.reload(_bria_fg); _bria_fg.on_use_this_image()"}
 addUserKnob {1 result_variant_count l _variant_count +HIDDEN}
 result_variant_count 1
 addUserKnob {26 prompt_sep l "" +STARTLINE}
 addUserKnob {43 prompt l Prompt t "Enter your prompt here!"}
 prompt "Create a single photorealistic raw on-set frame from a high-budget Hollywood family adventure film, captured before post-production. Show a charismatic lead character in a visually exciting, cinematic moment on a soundstage, performing an action that feels adventurous and urgent but not violent — for example: reaching toward something just off frame, bracing during a dramatic vehicle shake, running across a collapsing bridge section, reacting in awe to something enormous, or helping a child or companion across a dangerous gap. The character should be standing on a partial practical set, with a large green screen backdrop clearly visible behind them. The image must feel like a real production plate from a major studio shoot: raw, uncomposited, and pre-VFX. Include subtle wrinkles and seams in the green screen, a few tracking markers, and a slight amount of green spill on the character’s clothing or hair. Include partial stage equipment barely visible at the far edges of frame, such as a c-stand, cable, flag, sandbag, or light stand, while keeping them peripheral and believable. The practical set in frame should be visually interesting and family-friendly — such as a jungle rope bridge section, a vehicle cockpit, a magical attic platform, a museum ledge, or a train car doorway — with tactile detail and cinematic composition. Lighting should be beautiful, dramatic, and intentional, with strong storytelling clarity, emotional readability, and a sense of wonder and discovery. The frame should feel like a premium behind-the-scenes plate from an expertly directed family adventure movie. No final visual effects, no digital background replacement, no explosions, no weapons, no tactical gear, no war imagery, no heavy destruction, no blood, and no finished color grading.\n\n\n\n\n"
 addUserKnob {6 use_negative_prompt l Negative +STARTLINE}
 addUserKnob {43 negative_prompt l Negative t "Enter your negative prompt here!" +HIDDEN}
 negative_prompt "\n\n\n\n\n"
 addUserKnob {6 use_structured_prompt l "Structured Prompt (JSON)" +STARTLINE}
 addUserKnob {22 load_structured_prompt l "Load JSON/VGL" t "Load a JSON/VGL file into Structured Prompt as text." -STARTLINE +DISABLED T "import importlib, common as _bria_common, fibo_generate as _bria_fg; importlib.reload(_bria_common); importlib.reload(_bria_fg); _bria_fg.on_load_structured_prompt()"}
 addUserKnob {43 structured_prompt l Structured t "Enter your structured prompt here!" +DISABLED +HIDDEN}
 addUserKnob {1 prompt_link_status l "Prompt Source" +DISABLED}
 prompt_link_status manual
 addUserKnob {1 prompt_manual_stash l _prompt_stash +HIDDEN}
 addUserKnob {1 tailored_model_id l "Tailored Model ID" +HIDDEN}
 addUserKnob {7 tailored_model_influence l "Tailored Influence" t "Optional. Range: 0.0 to < 2.0. 0 means unset." +HIDDEN R 0 1.99}
