Group {
 name Bria_Generate_VGL
 knobChanged "import structured_prompt as _bria_sp; _bria_sp.on_knob_changed()"
 xpos 1800
 ypos -2452
 postage_stamp true
 addUserKnob {20 settings_tab l Settings}
 addUserKnob {26 bria_header l "" +STARTLINE T "Bria : Generate VGL"}
 addUserKnob {4 pipeline l Pipeline M {standard lite}}
 addUserKnob {6 use_input_image l "Use Input Image" -STARTLINE}
 addUserKnob {6 use_structured_prompt_input l "Use Structured Prompt Input" -STARTLINE}
 addUserKnob {26 prompt_sep l "" +STARTLINE}
 addUserKnob {43 prompt l Prompt t "Describe the scene to generate structured prompt JSON."}
 prompt "using the input image as reference, create a foreground tree trunk with a beautiful and curious chameleon climbing on it, rendered over constant grey background. dont blur any part of the tree trunk it should be clearly in the foreground and would not be accidentally removed by a background removal process. The chameleon's scales should attempt to match the colors  and patterns from the input image. rule of 1/3rds, cinematic, photoreal\n\n\n"
 addUserKnob {22 load_structured_prompt_input l "Load JSON/VGL" t "Load a JSON/VGL file into Structured Prompt Input." +DISABLED T "import structured_prompt as _bria_sp; _bria_sp.on_load_structured_prompt_input()" +STARTLINE}
 addUserKnob {43 structured_prompt_input l "Structured Prompt Input" t "Optional existing structured prompt JSON for refine mode (requires Prompt)." +DISABLED +HIDDEN}
 structured_prompt_input "\n\n\n"
 addUserKnob {6 lock_vgl l "Lock VGL" -STARTLINE}
 addUserKnob {22 run_structured_prompt l "Generate VGL" T "import structured_prompt as _bria_sp; _bria_sp.on_structured_prompt()" +STARTLINE}
 addUserKnob {6 use_custom_label l "Custom File Name" t "Enable to set a custom name for the saved JSON filename." -STARTLINE}
 addUserKnob {1 output_label l Name t "Name used in the output filename: bria_structured_prompt_\{name\}_\{id\}.json" +DISABLED +HIDDEN}
 addUserKnob {26 result_sep l "" +STARTLINE}
 addUserKnob {6 use_global_project_path l "Use Global Project Path" +STARTLINE}
 addUserKnob {2 result_path l "Result Path" t "Optional directory or .json file path for saved structured prompt output. Default folder is prompt."}
 result_path /var/folders/q6/fsklnzwx20jg_ydn82gmshyw0000gn/T/bria/prompt/bria_structured_prompt_result_1779146332365.json
 addUserKnob {43 structured_prompt_output l "Structured Prompt" t "Generated structured prompt JSON output."}
 structured_prompt_output "\{\n  \"short_description\": \"A photorealistic cinematic shot of a vibrant, curious chameleon with scales matching colors and patterns from the input reference, climbing on a prominently featured, textured tree trunk in the foreground. The background is a consistent, unfocused grey, ensuring the tree trunk and chameleon stand out clearly.\",\n  \"objects\": \[\n    \{\n      \"description\": \"A beautiful and curious chameleon, its scales displaying a complex pattern of greens, blues, yellows, and hints of orange, mimicking the colors and patterns from the provided input image. Its skin appears slightly textured and iridescent, catching the light.\",\n      \"location\": \"center-right, on the tree trunk\",\n      \"relationship\": \"The chameleon is actively climbing on the tree trunk, its body contoured to the bark.\",\n      \"relative_size\": \"medium within frame\",\n      \"shape_and_color\": \"Irregular, elongated body with a coiled tail and prominent eyes; multi-colored with dominant greens, blues, and yellows.\",\n      \"texture\": \"Scaly, slightly bumpy, and iridescent\",\n      \"appearance_details\": \"Its eyes are independently swiveling, one looking towards the viewer with a curious expression, the other scanning its surroundings. Its feet are gripping the bark firmly.\",\n      \"orientation\": \"Facing slightly left, body angled upwards along the trunk.\"\n    \},\n    \{\n      \"description\": \"A thick, gnarled tree trunk, heavily textured with deep furrows, mossy patches, and some small lichen growths. Its surface is dry and weathered, showing signs of age.\",\n      \"location\": \"foreground, occupying the left two-thirds of the frame\",\n      \"relationship\": \"The tree trunk serves as the primary support and environment for the chameleon.\",\n      \"relative_size\": \"large within frame\",\n      \"shape_and_color\": \"Cylindrical, irregular, brown and grey with green and yellow accents from moss/lichen.\",\n      \"texture\": \"Rough, deeply fissured bark with visible moss and lichen.\",\n      \"appearance_details\": \"No blurring whatsoever, every detail of the bark is sharp and clear, emphasizing its solidity and presence.\",\n      \"orientation\": \"Vertical, slightly angled from bottom-left to top-right.\"\n    \}\n  ],\n  \"background_setting\": \"A completely uniform, soft grey background that provides a stark contrast to the vibrant chameleon and textured tree trunk, ensuring no distractions.\",\n  \"lighting\": \{\n    \"conditions\": \"Bright, soft studio lighting, simulating natural daylight.\",\n    \"direction\": \"Front-lit with a subtle fill light, emphasizing the chameleon's colors and the trunk's texture.\",\n    \"shadows\": \"Soft, diffused shadows cast by the chameleon and the deeper crevices of the tree trunk, adding depth without harshness.\"\n  \},\n  \"aesthetics\": \{\n    \"composition\": \"Rule of thirds, with the chameleon positioned at an intersection point, and the tree trunk forming a strong diagonal element. Close-up on the chameleon and tree trunk.\",\n    \"color_scheme\": \"High contrast between the vibrant, multi-colored chameleon and the earthy tones of the tree trunk against the neutral grey background.\",\n    \"mood_atmosphere\": \"Curious, naturalistic, and a sense of quiet observation.\",\n    \"aesthetic_score\": \"very high\",\n    \"preference_score\": \"very high\"\n  \},\n  \"photographic_characteristics\": \{\n    \"depth_of_field\": \"Shallow, with the chameleon and the foreground tree trunk in sharp focus.\",\n    \"focus\": \"Sharp focus on both the chameleon and the entire visible portion of the tree trunk.\",\n    \"camera_angle\": \"Eye-level with the chameleon.\",\n    \"lens_focal_length\": \"Portrait lens (e.g., 85mm-100mm) to achieve a cinematic, slightly compressed look and clear subject isolation.\"\n  \},\n  \"style_medium\": \"photograph\",\n  \"context\": \"This is a concept for a high-quality, photorealistic image, possibly for a nature documentary still, an educational animal encyclopedia, or a striking piece of wildlife photography art, emphasizing the intricate details of the chameleon and its environment.\",\n  \"artistic_style\": \"realistic, cinematic, detailed\"\n\}\n\n\n\n\n"
